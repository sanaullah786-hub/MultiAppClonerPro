<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="112dp"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/tileIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/tileTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/tileSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#E6FFFFFF" android:textSize="11sp" />
</LinearLayout>
